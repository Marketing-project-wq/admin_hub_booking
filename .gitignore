# Gambar diagram tubuh EMR — ditaruh manual oleh desainer, tidak di-commit.
# Catatan: README.md di folder yang sama sengaja TIDAK di-ignore (dokumentasi tetap ikut git).
artifacts/admin-panel/public/images/body-diagram/*.png
artifacts/admin-panel/public/images/body-diagram/*.jpg
artifacts/admin-panel/public/images/body-diagram/*.jpeg

# Data import ICD-10 sekali pakai (dataset besar, bukan bagian aplikasi)
artifacts/admin-panel/scripts/*.csv

# WASM MediaPipe (~32MB) — di-copy dari node_modules saat build (vite plugin copyMediapipeWasm).
# JANGAN di-commit. Model .task (public/models/) TETAP di-commit.
artifacts/admin-panel/public/mediapipe-wasm/

# Metadata lokal supabase CLI (dibuat saat functions deploy) — jangan di-commit.
supabase/.temp/
